// Base de datos de events (events_db). Solo este servicio la usa.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum ReservationStatus {
  RESERVED
  RELEASED
}

model Event {
  id          String      @id @default(uuid()) @db.Uuid
  organizerId String      @map("organizer_id") @db.Uuid
  name        String      @db.VarChar(150)
  description String      @default("")
  venue       String      @db.VarChar(150)
  startsAt    DateTime    @map("starts_at")
  imageUrl    String?     @map("image_url") @db.VarChar(500)
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  sectors      Sector[]
  reservations Reservation[]

  @@index([status, startsAt])
  @@index([organizerId])
  @@map("events")
}

model Sector {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  name       String   @db.VarChar(50)
  priceCents Int      @map("price_cents")
  capacity   Int
  // Cupo disponible. Solo se modifica con UPDATE atómicos (ver EventsService / ReservationsService).
  available  Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([eventId, name])
  @@map("sectors")
}

model Reservation {
  id             String            @id @default(uuid()) @db.Uuid
  orderId        String            @unique @map("order_id") @db.Uuid
  eventId        String            @map("event_id") @db.Uuid
  sectorId       String            @map("sector_id") @db.Uuid
  quantity       Int
  unitPriceCents Int               @map("unit_price_cents")
  totalCents     Int               @map("total_cents")
  status         ReservationStatus @default(RESERVED)
  createdAt      DateTime          @default(now()) @map("created_at")
  releasedAt     DateTime?         @map("released_at")

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Restrict)

  @@index([sectorId])
  @@map("reservations")
}

# --- events: copiar como .env y ajustar ---
SERVICE_NAME=events
PORT=3002
LOG_LEVEL=info

# PostgreSQL (creada con infra/postgres/init.sql)
DATABASE_URL=postgresql://events_user:events_pass@localhost:5432/events_db?schema=public

# Llave pública para validar los JWT que emite auth (events NO tiene la privada)
JWT_PUBLIC_KEY_PATH=../../keys/jwt-public.pem

# Clave compartida para las rutas /internal/* (debe ser igual en orders)
INTERNAL_API_KEY=dev-internal-key-cambiar

# Opcional: solo si el navegador llama directo sin gateway
# CORS_ORIGIN=https://localhost:5173

# --- auth: copiar como .env y ajustar ---
SERVICE_NAME=auth
PORT=3001
LOG_LEVEL=info

# PostgreSQL (creada con infra/postgres/init.sql)
DATABASE_URL=postgresql://auth_user:auth_pass@localhost:5432/auth_db?schema=public

# Llaves RS256 (generadas con: node scripts/generate-jwt-keys.mjs desde la raíz)
JWT_PRIVATE_KEY_PATH=../../keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=../../keys/jwt-public.pem
JWT_EXPIRES_IN=8h

# Solo si llamas al servicio directo desde el navegador sin gateway (opcional)
# CORS_ORIGIN=https://localhost:5173

# Organizador inicial (npm run seed)
SEED_ORGANIZER_NAME=Organizador Demo
SEED_ORGANIZER_EMAIL=organizador@entradasya.local
SEED_ORGANIZER_PASSWORD=Organizador123

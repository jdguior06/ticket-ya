# --- tickets: copiar como .env y ajustar ---
SERVICE_NAME=tickets
PORT=3005
LOG_LEVEL=info

# PostgreSQL (creada con infra/postgres/init.sql)
DATABASE_URL=postgresql://tickets_user:tickets_pass@localhost:5432/tickets_db?schema=public

# Llave pública para validar los JWT de auth
JWT_PUBLIC_KEY_PATH=../../keys/jwt-public.pem

# Clave interna compartida por todo el sistema (orders y checkin llaman a /internal/*)
INTERNAL_API_KEY=dev-internal-key-cambiar

# Carpeta local de los PDF (se crea sola). En la raíz del repo, storage/ está en .gitignore
TICKETS_STORAGE_DIR=../../storage/tickets

# Prefijo público con el que la web descarga el PDF (a través del gateway)
TICKETS_PUBLIC_BASE_PATH=/api/tickets

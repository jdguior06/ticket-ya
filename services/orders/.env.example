# --- orders: copiar como .env y ajustar ---
SERVICE_NAME=orders
PORT=3003
LOG_LEVEL=info

# PostgreSQL (creada con infra/postgres/init.sql)
DATABASE_URL=postgresql://orders_user:orders_pass@localhost:5432/orders_db?schema=public

# Llave pública para validar los JWT de auth
JWT_PUBLIC_KEY_PATH=../../keys/jwt-public.pem

# Clave interna compartida por todo el sistema (la misma en events, payments, tickets y notifications)
INTERNAL_API_KEY=dev-internal-key-cambiar

# Servicios a los que llama orders (siempre con timeout)
EVENTS_URL=http://localhost:3002
PAYMENTS_URL=http://localhost:3004
TICKETS_URL=http://localhost:3005
NOTIFICATIONS_URL=http://localhost:3006
HTTP_TIMEOUT_MS=5000

# Enlace "ver mis entradas" que va en el correo
WEB_BASE_URL=https://localhost:5173

# Reconciliador de órdenes pendientes (docs/CONTRATOS.md §5)
RECONCILE_INTERVAL_MS=60000
RECONCILE_MIN_AGE_MS=60000
PENDING_TIMEOUT_MS=600000

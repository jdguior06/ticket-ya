# Administrado por Ansible (infra/ansible). No editar a mano.
# Variables de {{ s.nombre }}: las lee systemd (EnvironmentFile) y el script de despliegue (migraciones).
SERVICE_NAME={{ s.nombre }}
PORT={{ s.puerto }}
LOG_LEVEL=info
NODE_ENV=production
{% if s.bd %}
DATABASE_URL=postgresql://{{ s.nombre }}_user:{{ bd_passwords[s.nombre] }}@127.0.0.1:5432/{{ s.nombre }}_db?schema=public
{% endif %}
{% if s.nombre != 'payments' and s.nombre != 'notifications' %}
JWT_PUBLIC_KEY_PATH={{ app_config }}/keys/jwt-public.pem
{% endif %}
{% if s.nombre != 'auth' %}
INTERNAL_API_KEY={{ internal_api_key }}
{% endif %}
{% if s.nombre == 'auth' %}
JWT_PRIVATE_KEY_PATH={{ app_config }}/keys/jwt-private.pem
JWT_EXPIRES_IN=8h
SEED_ORGANIZER_NAME={{ organizador_inicial.nombre }}
SEED_ORGANIZER_EMAIL={{ organizador_inicial.email }}
SEED_ORGANIZER_PASSWORD={{ organizador_inicial.password }}
{% elif s.nombre == 'orders' %}
EVENTS_URL=http://127.0.0.1:3002
PAYMENTS_URL=http://127.0.0.1:3004
TICKETS_URL=http://127.0.0.1:3005
NOTIFICATIONS_URL=http://127.0.0.1:3006
HTTP_TIMEOUT_MS=5000
WEB_BASE_URL={{ 'https' if usar_https else 'http' }}://{{ dominio }}
RECONCILE_INTERVAL_MS={{ reconcile_interval_ms }}
RECONCILE_MIN_AGE_MS=60000
PENDING_TIMEOUT_MS={{ pending_timeout_ms }}
{% elif s.nombre == 'tickets' %}
TICKETS_STORAGE_DIR={{ app_datos }}/tickets
TICKETS_PUBLIC_BASE_PATH=/api/tickets
{% elif s.nombre == 'notifications' %}
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@entradasya.bo
SMTP_TIMEOUT_MS=3000
{% elif s.nombre == 'checkin' %}
TICKETS_URL=http://127.0.0.1:3005
HTTP_TIMEOUT_MS=5000
{% endif %}
